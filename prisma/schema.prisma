// Prisma-Schema für Morgenkorb.
//
// Wir benutzen Postgres, weil die App auf Vercel läuft. Vercel setzt das
// Dateisystem regelmäßig zurück – eine SQLite-Datei wäre dort nach kurzer
// Zeit weg, samt aller Bestellungen. Postgres läuft als eigener Dienst
// daneben und bleibt erhalten.
//
// Die DATABASE_URL kommt aus den Umgebungsvariablen (lokal aus .env,
// auf Vercel aus den Project Settings).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Eine Kategorie im Sortiment. Im Admin anlegbar und löschbar.
model Category {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  /// kleinere Zahl = weiter oben im Shop
  sortierung Int     @default(100)
  aktiv      Boolean @default(true)

  produkte Product[]

  @@index([sortierung])
}

/// Ein Produkt aus dem Sortiment.
model Product {
  id   Int    @id @default(autoincrement())
  name String @unique
  /// Verkaufspreis in CENT (Integer!), niemals als Kommazahl speichern.
  /// Bei Produkten mit Varianten ist das der Preis der ersten Variante.
  preis Int
  /// Einkaufspreis in Cent – nur für die Margenrechnung im Admin.
  einkauf Int?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  bildUrl String?
  aktiv   Boolean @default(true)

  /// Wie viele Stück gibt es noch? null = unbegrenzt.
  bestand Int?

  /// Merkmale zum Filtern, kommagetrennt: "zuckerfrei,vegan,koffeinfrei"
  merkmale String?

  /// Zutaten und Allergene – kommen vom Admin, nicht aus dem Seed.
  /// Verbindlich ist immer die Verpackung.
  zutaten   String?
  allergene String?

  varianten ProductVariant[]
  items     OrderItem[]
  favoriten Favorit[]
  ersatzFuer OrderItem[] @relation("Ersatzprodukt")

  @@index([categoryId])
}

/// Eine Sorte innerhalb eines Produkts, z. B. Fanta "Orange" / "Exotic".
/// Varianten dürfen unterschiedlich viel kosten.
model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int
  name       String
  /// Verkaufspreis in Cent für genau diese Sorte
  preis      Int
  einkauf    Int?
  aktiv      Boolean @default(true)
  sortierung Int     @default(100)

  /// Restbestand dieser Sorte. null = unbegrenzt.
  bestand  Int?
  merkmale String?

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@unique([productId, name])
  @@index([productId])
}

/// Eine Bestellung von einer Person für einen Tag.
model Order {
  id            String   @id @default(cuid()) // zufällige ID -> Bestätigungslink ist nicht erratbar
  name          String
  klasse        String
  notiz         String?
  erstelltAm    DateTime @default(now())
  bezahlt       Boolean  @default(false)
  /// true = Tag wurde abgeschlossen, Bestellung liegt im Archiv
  abgeschlossen Boolean  @default(false)

  /// Wer hat bestellt? Leer bei Bestellungen ohne Konto (Gast).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Wo steht die Bestellung gerade? Siehe src/lib/status.ts
  /// EINGEGANGEN | IN_BEARBEITUNG | VERSENDET | ZUGESTELLT | STORNIERT
  status   String   @default("EINGEGANGEN")
  statusAm DateTime @default(now())

  /// Wie wird bezahlt? BAR (bei Übergabe) oder KARTE (Stripe)
  zahlart String @default("BAR")
  /// OFFEN | BEZAHLT | FEHLGESCHLAGEN | ERSTATTET
  /// Bei Karte setzt das ausschließlich der Stripe-Webhook.
  zahlstatus String    @default("OFFEN")
  bezahltAm  DateTime?

  /// Stripe-Kennungen. Die Session-ID ist einmalig, damit ein doppelt
  /// zugestellter Webhook nicht doppelt verbucht.
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  /// Schon erstatteter Betrag in Cent (bei Änderung nach unten)
  erstattetCent Int @default(0)

  /// Was tun, wenn etwas nicht verfügbar ist?
  /// WEGLASSEN | ERSATZ | RUECKSPRACHE
  ersatzRegel String @default("WEGLASSEN")

  /// Wann wurde zuletzt geändert und von wem
  geaendertAm DateTime?

  items    OrderItem[]
  verlauf  OrderStatus[]

  @@index([abgeschlossen])
  @@index([erstelltAm])
  @@index([userId])
  @@index([status])
}

/// Jede Statusänderung wird mitgeschrieben – daraus bauen wir die
/// Verfolgungsanzeige für den Kunden ("Bestellung erhalten -> ...").
model OrderStatus {
  id      Int      @id @default(autoincrement())
  orderId String
  status  String
  am      DateTime @default(now())
  /// optionale Notiz vom Admin, z. B. "Cola war aus"
  notiz   String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Ein Konto. Passwörter werden NIE im Klartext gespeichert, sondern nur
/// als Hash (siehe src/lib/passwort.ts).
model User {
  id           String   @id @default(cuid())
  /// immer klein geschrieben gespeichert, damit "Anna@..." und "anna@..."
  /// dasselbe Konto sind
  email        String   @unique
  name         String
  klasse       String?
  passwortHash String
  /// "BESTELLER" oder "ADMIN" – als Text, damit SQLite und Postgres beide
  /// damit klarkommen (SQLite kennt keine enums)
  rolle        String   @default("BESTELLER")
  erstelltAm   DateTime @default(now())

  /// Wann wurde die E-Mail bestätigt? Solange leer, ist das Konto
  /// angelegt, aber noch nicht freigeschaltet.
  emailVerifiziertAm DateTime?

  /// Möchte eine Erinnerung, wenn vor Bestellschluss noch etwas im Korb liegt
  erinnerung Boolean @default(false)

  sitzungen Session[]
  orders    Order[]
  codes     VerificationCode[]
  favoriten Favorit[]
  korb      Cart?
  wuensche  Wunsch[]
  stimmen   WunschStimme[]
}

/// Ein mit Herz markiertes Produkt.
model Favorit {
  userId    String
  productId Int
  am        DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId])
}

/// Der gespeicherte Warenkorb eines angemeldeten Nutzers.
/// Nur dafür da, damit die Erinnerung vor Bestellschluss weiß, wer noch
/// etwas im Korb hat – und damit der Korb das Gerät wechseln kann.
model Cart {
  userId       String   @id
  /// Der Warenkorb als JSON-Text: { "p12v3": 2, ... }
  inhalt       String
  aktualisiert DateTime @updatedAt
  /// Wann wurde zuletzt erinnert? Verhindert doppelte Mails.
  erinnertAm   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([aktualisiert])
}

/// Ein Produktwunsch, den andere unterstützen können.
model Wunsch {
  id         String   @id @default(cuid())
  text       String
  /// Name des Vorschlagenden (auch für Gäste sichtbar)
  name       String
  userId     String?
  erstelltAm DateTime @default(now())
  /// Vom Admin erledigt (ins Sortiment aufgenommen oder abgelehnt)
  erledigt   Boolean  @default(false)
  antwort    String?

  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  stimmen WunschStimme[]

  @@index([erledigt])
}

/// Eine Stimme für einen Wunsch. Pro Konto nur eine.
model WunschStimme {
  wunschId String
  userId   String
  am       DateTime @default(now())

  wunsch Wunsch @relation(fields: [wunschId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([wunschId, userId])
  @@index([wunschId])
}

/// Änderungsprotokoll: wer hat wann was geändert.
model Protokoll {
  id     String   @id @default(cuid())
  am     DateTime @default(now())
  /// Wer war es? E-Mail oder "Kunde" / "Stripe"
  wer    String
  /// z. B. "Preis geändert", "Bestellung storniert"
  aktion String
  /// Worum ging es? z. B. "Produkt 12 (Fanta)"
  objekt String
  /// Vorher -> nachher, als lesbarer Text
  details String?

  @@index([am])
}

/// Ein Bestätigungscode für die E-Mail-Verifizierung.
/// Gespeichert wird nur der Hash – wer die Datenbank liest, kennt den
/// Code trotzdem nicht.
model VerificationCode {
  id         String   @id @default(cuid())
  userId     String
  codeHash   String
  laeuftAbAm DateTime
  /// Fehlversuche – nach zu vielen ist der Code verbrannt
  versuche   Int      @default(0)
  erstelltAm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([laeuftAbAm])
}

/// Einstellungen, die der Admin über die Website ändern kann –
/// z. B. das Bestellzeitfenster. Damit steht nichts mehr fest im Code.
model Setting {
  schluessel String   @id
  wert       String
  geaendert  DateTime @updatedAt
}

/// Eine angemeldete Sitzung ("eingeloggt bleiben").
/// Im Cookie steht ein zufälliger Schlüssel, in der Datenbank nur dessen
/// Hash. Wer die Datenbank liest, kann sich damit also nicht anmelden.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  laeuftAbAm DateTime
  erstelltAm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([laeuftAbAm])
}

/// Eine Zeile innerhalb einer Bestellung ("3x Cola").
model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   String
  productId Int
  /// Welche Sorte? Leer bei Produkten ohne Varianten.
  variantId Int?
  /// Name der Sorte zum Bestellzeitpunkt – bleibt auch, wenn die
  /// Variante später gelöscht wird.
  variantName String?
  /// Womit darf ersetzt werden, wenn es das Produkt nicht gibt?
  ersatzProductId Int?
  menge     Int
  /// Preis in Cent zum Zeitpunkt der Bestellung – so bleibt die alte
  /// Bestellung korrekt, auch wenn sich der Produktpreis später ändert.
  preisBeimKauf Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  ersatz  Product?        @relation("Ersatzprodukt", fields: [ersatzProductId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}
