# ---- Datenbank (Postgres) ----
# Auf Vercel wird diese Variable von der Postgres-Integration automatisch
# gesetzt – auch mit Präfix (z. B. MorgenkorbDB_DATABASE_URL) wird sie gefunden.
DATABASE_URL="postgresql://benutzer:passwort@host:5432/morgenkorb?sslmode=require"

# ---- Admin-Zugang ----
# Damit meldest du dich unter /anmelden an. Das Konto wird beim ersten
# Anmeldeversuch automatisch angelegt. Änderst du das Passwort hier,
# gilt beim nächsten Anmelden das neue.
ADMIN_EMAIL="du@example.com"
ADMIN_PASSWORT="bitte-aendern"
ADMIN_NAME="Einkauf"

# Optional: weitere Adressen, die Admin werden (kommagetrennt).
# ADMIN_EMAILS="zweiter@example.com,dritter@example.com"
