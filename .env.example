# ---- Datenbank ----
# SQLite (Standard, gut zum Entwickeln):
DATABASE_URL="file:./dev.db"
# Später für Postgres (siehe README):
# DATABASE_URL="postgresql://user:passwort@host:5432/morgenkorb?schema=public"

# ---- Admin-Bereich ----
# Passwort für /admin. UNBEDINGT ändern!
ADMIN_PASSWORD="bitte-aendern"
# Zufälliger Text, mit dem das Login-Cookie abgesichert wird.
# Erzeugen z. B. mit: openssl rand -hex 32
ADMIN_SECRET="bitte-durch-langen-zufallstext-ersetzen"
