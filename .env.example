# ---- Datenbank (Postgres) ----
# Auf Vercel setzt die Postgres-Integration das automatisch – auch mit
# Präfix (z. B. MorgenkorbDB_DATABASE_URL) wird es gefunden.
DATABASE_URL="postgresql://benutzer:passwort@host:5432/morgenkorb?sslmode=require"

# ---- Admin-Zugang ----
# Damit meldest du dich unter /anmelden an. Das Konto wird beim ersten
# Anmeldeversuch automatisch angelegt.
ADMIN_EMAIL="du@example.com"
ADMIN_PASSWORT="bitte-aendern"
ADMIN_NAME="Einkauf"
# Optional: weitere Admins, kommagetrennt
# ADMIN_EMAILS="zweiter@example.com"

# ---- E-Mail-Versand (für die Bestätigungscodes) ----
# Konto bei resend.com anlegen, Domain verifizieren, API-Key erzeugen.
RESEND_API_KEY="re_..."
MAIL_ABSENDER="Morgenkorb <noreply@deine-domain.de>"
# Nur zum Ausprobieren ohne echten Versand: Code landet im Server-Log.
# NIEMALS in Produktion einschalten.
# MAIL_TESTMODUS="1"

# ---- Stripe (Kartenzahlung, optional) ----
# Ohne diese Werte gibt es einfach nur Barzahlung.
# Der geheime Schlüssel bleibt IMMER auf dem Server.
STRIPE_SECRET_KEY="sk_live_..."
# Aus Stripe: Developers -> Webhooks -> Endpoint anlegen auf
# https://deine-domain/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."
# Eigene Adresse für die Rücksprung-Links (auf Vercel automatisch erkannt)
# BASE_URL="https://morgenkorb.vercel.app"
