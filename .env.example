# ---- Datenbank (Postgres) ----
# Auf Vercel wird diese Variable von der Postgres-Integration automatisch
# gesetzt. Lokal trägst du hier dieselbe URL ein (oder eine eigene).
# Format:
DATABASE_URL="postgresql://benutzer:passwort@host:5432/morgenkorb?sslmode=require"

# ---- Admin-Bereich ----
# Passwort für /admin. UNBEDINGT ändern!
ADMIN_PASSWORD="bitte-aendern"
# Zufälliger Text, mit dem das Login-Cookie abgesichert wird.
# Erzeugen z. B. mit: openssl rand -hex 32
ADMIN_SECRET="bitte-durch-langen-zufallstext-ersetzen"
